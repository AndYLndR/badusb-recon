$contenido = @'
# Configuracion local (NO subir!)
config.json
config.local.ps1
*.local.json
*.local.ps1

# Payloads generados
payload.b64.txt
payload_ducky.txt
payloads/payload.b64.txt
payloads/payload_ducky.txt

# Logs del payload
*.log
badusb_recon_*.log

# Outputs de herramientas
_decoded_check.ps1
*.tmp

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# IDE
.vscode/
.idea/
*.swp
'@

[IO.File]::WriteAllText("$PWD\.gitignore", $contenido, [Text.UTF8Encoding]::new($false))